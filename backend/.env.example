# Copy these names into your shell or IDE run configuration.
# This file is NOT loaded automatically by Spring Boot.
# Never commit real credentials.

DB_USERNAME=your-mysql-username
DB_PASSWORD=your-mysql-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional
# DB_URL=jdbc:mysql://localhost:3306/expense_tracker?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# JWT_EXPIRATION_MS=3600000
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# One-time first-admin bootstrap. Remove these after the first successful startup.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ASSIGN_LEGACY_EXPENSES=false
